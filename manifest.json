{
  "manifest_version": 3,
  "name": "Snap5 — Screenshot & Screen Recorder",
  "short_name": "Snap5",
  "version": "1.1.0",
  "description": "Screenshots with 5 5 and 5 5 5, markup, and a screen recorder with mic, camera, drawing and trim.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage", "downloads", "clipboardWrite", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Snap5",
    "default_popup": "pages/popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/trigger.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "options_ui": { "page": "pages/options.html", "open_in_tab": true },
  "commands": {
    "capture-area": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Capture a selected area"
    },
    "capture-full": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Capture full page (auto copy)"
    },
    "capture-visible": {
      "suggested_key": { "default": "Alt+Shift+V" },
      "description": "Capture visible part"
    },
    "toggle-recording": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Open the recorder, or stop recording"
    },
    "pause-recording": {
      "description": "Pause or resume recording"
    },
    "capture-delayed": {
      "description": "Capture with a timer"
    }
  }
}
